{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pthd:schema:event-catalog:1.0.0",
  "title": "Pizza Tycoon HD optional calendar event catalog 1.0.0",
  "description": "Versioned, offline catalog of optional cosmetic events (contract section 12). Resolution is a pure function of (catalog revision, mode, date, location, user toggles); it reads no clock in in-game mode, makes no network request and draws from no RNG stream. Overlays are presentation only: they can never change economy state, collisions, room access or ownership.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "catalog_id", "catalog_revision", "sources", "events"],
  "properties": {
    "format": { "const": "pthd.event-catalog" },
    "schema_version": { "const": "1.0.0" },
    "catalog_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9-]{1,63}$" },
    "catalog_revision": { "type": "integer", "minimum": 1 },
    "sources": {
      "type": "array",
      "maxItems": 64,
      "description": "Authoritative references for date rules and observance. A date_table without a source cannot be admitted (validator EVT-2).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "publisher", "reference"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$" },
          "title": { "type": "string", "maxLength": 120 },
          "publisher": { "type": "string", "maxLength": 80 },
          "reference": { "type": "string", "maxLength": 300 },
          "retrieved_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
          "verification": { "enum": ["unverified", "verified"] }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "event_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9-]{1,63}$" },
    "overlay_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "asset_id", "asset_revision"],
      "properties": {
        "slot": {
          "enum": ["city-building", "city-scenery", "restaurant-decor", "people-costume", "ui-frame", "menu-backdrop", "effect"],
          "description": "Draw layer the overlay joins. None of these layers is read by navigation, collision or economy code."
        },
        "asset_id": { "type": "string", "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*){0,3}$" },
        "asset_revision": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,31}$" },
        "costume_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}:[a-z0-9][a-z0-9-]{1,47}$" },
        "motion": { "enum": ["static", "subtle", "animated", "flashing"] },
        "reduced_motion_replacement": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/overlay_ref" }],
          "description": "Required (non-null) when motion is animated or flashing (validator EVT-4). Reduced motion never shows a flashing overlay."
        }
      }
    },
    "date_rule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "description": "Active on every date. Used for decorations that belong to a location all year (the North Pole's base winter look is location art, not an event).",
          "properties": { "kind": { "const": "always" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "month", "day"],
          "description": "Same month/day every year (proleptic Gregorian).",
          "properties": {
            "kind": { "const": "fixed-date" },
            "month": { "type": "integer", "minimum": 1, "maximum": 12 },
            "day": { "type": "integer", "minimum": 1, "maximum": 31 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "dates", "source_ref"],
          "description": "Movable observances: explicit sourced dates. Outside the listed years the event is inactive; nothing is extrapolated.",
          "properties": {
            "kind": { "const": "date-table" },
            "dates": {
              "type": "array",
              "minItems": 1,
              "maxItems": 200,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["year", "month", "day"],
                "properties": {
                  "year": { "type": "integer", "minimum": 1900, "maximum": 2200 },
                  "month": { "type": "integer", "minimum": 1, "maximum": 12 },
                  "day": { "type": "integer", "minimum": 1, "maximum": 31 }
                }
              }
            },
            "source_ref": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$" }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "revision", "title", "category", "applicability", "date_rule", "window", "overlays", "options"],
      "properties": {
        "event_id": { "$ref": "#/$defs/event_id" },
        "revision": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 48 },
        "category": { "enum": ["seasonal", "secular-holiday", "religious-holiday", "cultural", "commemorative", "location-theme"] },
        "alternative_of": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/event_id" }],
          "description": "A secular or neutral alternative of another event; the settings screen offers them together."
        },
        "applicability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope"],
          "properties": {
            "scope": { "enum": ["everywhere", "listed"] },
            "location_keys": {
              "type": "array",
              "maxItems": 256,
              "uniqueItems": true,
              "items": { "$ref": "urn:pthd:schema:location-definition:1.0.0#/$defs/location_key" }
            },
            "regions": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": { "$ref": "urn:pthd:schema:location-definition:1.0.0#/$defs/region_id" }
            },
            "bonus_routes": {
              "type": "array",
              "maxItems": 8,
              "uniqueItems": true,
              "items": { "$ref": "urn:pthd:schema:location-definition:1.0.0#/$defs/bonus_route_id" }
            },
            "countries": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z]{2}$" }
            },
            "hemisphere": { "enum": ["any", "north", "south"] }
          }
        },
        "date_rule": { "$ref": "#/$defs/date_rule" },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before_days", "after_days"],
          "properties": {
            "before_days": { "type": "integer", "minimum": 0, "maximum": 60 },
            "after_days": { "type": "integer", "minimum": 0, "maximum": 60 }
          }
        },
        "priority": { "type": "integer", "minimum": 0, "maximum": 100, "default": 50 },
        "overlays": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/overlay_ref" }
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "required": ["optional", "default_enabled"],
          "properties": {
            "optional": { "const": true },
            "default_enabled": { "type": "boolean" },
            "audio": { "type": "boolean", "description": "Event audio has its own toggle; off by default." }
          }
        }
      }
    }
  }
}
