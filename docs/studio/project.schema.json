{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pthd:schema:studio-project:1.0.0",
  "title": "Pizza Tycoon HD Studio project document 1.0.0",
  "description": "The one editable document shared by Quick Create, Guided Create and the Full Editor (contract section 9). It wraps a working LocationDefinition with provenance, locks, generation inputs, revision history, undo/redo, branches and receipts. The working definition must always be structurally valid against location.schema.json; semantic validity is what the validation receipt records. No floating-point numbers anywhere.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "project_id",
    "location_key",
    "created_utc",
    "updated_utc",
    "head",
    "working",
    "locks",
    "generation",
    "history",
    "branches",
    "receipts"
  ],
  "properties": {
    "format": { "const": "pthd.studio-project" },
    "schema_version": { "const": "1.0.0" },
    "project_id": { "$ref": "#/$defs/project_id" },
    "location_key": {
      "$ref": "urn:pthd:schema:location-definition:1.0.0#/$defs/location_key",
      "description": "Assigned once when the project is created; equals working.definition.location_key. Rename never changes it."
    },
    "created_utc": { "$ref": "#/$defs/utc" },
    "updated_utc": { "$ref": "#/$defs/utc" },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "branch", "document_sha256"],
      "description": "The revision the working copy currently shows (the undo cursor).",
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "branch": { "$ref": "#/$defs/branch_id" },
        "document_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "working": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "layers", "objects"],
      "properties": {
        "definition": { "$ref": "urn:pthd:schema:location-definition:1.0.0" },
        "layers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["terrain", "roads", "districts", "premises", "actors", "suppliers", "economy", "names", "placement", "art"],
          "description": "Each layer maps to a disjoint part of the definition (contract section 9.2) and to one generator stage.",
          "properties": {
            "terrain": { "$ref": "#/$defs/layer_state" },
            "roads": { "$ref": "#/$defs/layer_state" },
            "districts": { "$ref": "#/$defs/layer_state" },
            "premises": { "$ref": "#/$defs/layer_state" },
            "actors": { "$ref": "#/$defs/layer_state" },
            "suppliers": { "$ref": "#/$defs/layer_state" },
            "economy": { "$ref": "#/$defs/layer_state" },
            "names": { "$ref": "#/$defs/layer_state" },
            "placement": { "$ref": "#/$defs/layer_state" },
            "art": { "$ref": "#/$defs/layer_state" }
          }
        },
        "objects": {
          "type": "array",
          "maxItems": 4096,
          "description": "Per-object provenance for objects that differ from the layer default. Absent object = same origin as its layer.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "origin"],
            "properties": {
              "ref": { "$ref": "#/$defs/object_ref" },
              "origin": { "$ref": "#/$defs/origin" },
              "manual_fields": {
                "type": "array",
                "maxItems": 32,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/json_pointer" },
                "description": "Fields a person set by hand. Regeneration keeps them even without an explicit lock (contract section 9.4)."
              }
            }
          }
        }
      }
    },
    "locks": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/lock" }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "template", "settings", "seed", "stage_seeds"],
      "description": "Inputs of the deterministic generator (contract section 7). Quick Create fills all of it; Guided Create edits settings step by step; the Full Editor may leave it untouched.",
      "properties": {
        "generator": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "version"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$" },
                "version": { "$ref": "#/$defs/semver" }
              }
            }
          ]
        },
        "template": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "urn:pthd:schema:location-definition:1.0.0#/$defs/template_ref" }
          ]
        },
        "settings": { "$ref": "#/$defs/generation_settings" },
        "seed": { "$ref": "#/$defs/u64_decimal" },
        "stage_seeds": {
          "type": "object",
          "maxProperties": 9,
          "propertyNames": { "$ref": "#/$defs/stage_id" },
          "additionalProperties": { "$ref": "#/$defs/u64_decimal" },
          "description": "Derived seeds per stage, recorded so a selective regeneration of one stage leaves the other stages' streams unchanged."
        },
        "last_job": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["job_id", "state", "stages", "base_revision"],
              "properties": {
                "job_id": { "$ref": "#/$defs/job_id" },
                "state": { "enum": ["queued", "running", "cancelled", "failed", "succeeded"] },
                "stages": { "type": "array", "maxItems": 9, "uniqueItems": true, "items": { "$ref": "#/$defs/stage_id" } },
                "base_revision": { "type": "integer", "minimum": 1 },
                "result_revision": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
                "failure": { "anyOf": [{ "$ref": "#/$defs/finding" }, { "type": "null" }] }
              }
            }
          ]
        }
      }
    },
    "history": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revisions", "redo"],
      "properties": {
        "revisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "description": "Revision tree (parent pointers). Older revisions may be compacted into a checkpoint revision; published revisions are never compacted.",
          "items": { "$ref": "#/$defs/revision" }
        },
        "redo": {
          "type": "array",
          "maxItems": 2000,
          "description": "Revisions undone from the current branch, most recent first. Cleared when a new edit is made at head (the abandoned revisions stay in the tree).",
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "branches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["branch_id", "label", "head_revision", "created_utc", "purpose"],
        "properties": {
          "branch_id": { "$ref": "#/$defs/branch_id" },
          "label": { "type": "string", "minLength": 1, "maxLength": 48 },
          "head_revision": { "type": "integer", "minimum": 1 },
          "created_utc": { "$ref": "#/$defs/utc" },
          "purpose": { "enum": ["main", "variation", "try-safely", "restore", "import"] }
        }
      }
    },
    "receipts": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/validation_receipt" },
          { "$ref": "#/$defs/integration_receipt" },
          { "$ref": "#/$defs/gameplay_receipt" },
          { "$ref": "#/$defs/publication_receipt" }
        ]
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional and never semantic: switching mode changes only this block.",
      "properties": {
        "mode": { "enum": ["quick", "guided", "full"] },
        "guided_step": { "enum": ["identity", "terrain-roads", "districts", "premises", "economy", "appearance", "review"] }
      }
    }
  },
  "$defs": {
    "project_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "branch_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "job_id": { "type": "string", "pattern": "^job-[0-9a-f]{32}$" },
    "receipt_id": { "type": "string", "pattern": "^rcpt-[0-9a-f]{32}$" },
    "transaction_id": { "type": "string", "pattern": "^tx-[0-9a-f]{32}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$" },
    "u64_decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "json_pointer": { "type": "string", "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$", "maxLength": 200 },
    "origin": { "enum": ["generated", "manual", "imported", "mixed"] },
    "stage_id": {
      "enum": ["terrain", "roads", "districts", "premises", "actors", "suppliers", "economy", "names", "placement"]
    },
    "layer_id": {
      "enum": ["terrain", "roads", "districts", "premises", "actors", "suppliers", "economy", "names", "placement", "art"]
    },
    "layer_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "locked", "last_generated_revision"],
      "properties": {
        "origin": { "$ref": "#/$defs/origin" },
        "locked": { "type": "boolean" },
        "last_generated_revision": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] }
      }
    },
    "tile_rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 159 },
        "y": { "type": "integer", "minimum": 0, "maximum": 119 },
        "w": { "type": "integer", "minimum": 1, "maximum": 160 },
        "h": { "type": "integer", "minimum": 1, "maximum": 120 }
      }
    },
    "object_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "description": "Stable selector. Entity lists are addressed by entity id, never by array index (kit ARCHITECTURE.md rule, kept).",
      "properties": {
        "kind": {
          "enum": ["tiles", "district_cells", "district", "property", "actor", "food_supplier", "building_names", "display", "world", "economy", "assets", "ingredient_base_prices"]
        },
        "id": { "$ref": "urn:pthd:schema:location-definition:1.0.0#/$defs/entity_id" },
        "rect": { "$ref": "#/$defs/tile_rect" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["district", "property", "actor", "food_supplier"] } } },
          "then": { "required": ["id"], "not": { "required": ["rect"] } }
        },
        {
          "if": { "properties": { "kind": { "const": "tiles" } } },
          "then": { "required": ["rect"], "not": { "required": ["id"] } }
        }
      ]
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lock_id", "scope", "reason", "created_utc", "created_by"],
      "properties": {
        "lock_id": { "type": "string", "pattern": "^lock-[0-9a-f]{16}$" },
        "scope": { "enum": ["layer", "object", "field", "tile_rect"] },
        "layer": { "$ref": "#/$defs/layer_id" },
        "target": { "$ref": "#/$defs/object_ref" },
        "field": { "$ref": "#/$defs/json_pointer" },
        "rect": { "$ref": "#/$defs/tile_rect" },
        "reason": { "enum": ["manual-edit", "user-pin", "import", "published-reference"] },
        "note": { "type": "string", "maxLength": 200 },
        "created_utc": { "$ref": "#/$defs/utc" },
        "created_by": { "enum": ["user", "import", "system"] }
      },
      "allOf": [
        { "if": { "properties": { "scope": { "const": "layer" } } }, "then": { "required": ["layer"] } },
        { "if": { "properties": { "scope": { "const": "object" } } }, "then": { "required": ["target"] } },
        { "if": { "properties": { "scope": { "const": "field" } } }, "then": { "required": ["target", "field"] } },
        { "if": { "properties": { "scope": { "const": "tile_rect" } } }, "then": { "required": ["rect"] } }
      ]
    },
    "generation_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "region", "size", "density", "road_pattern", "district_count", "economic_difficulty", "starting_opportunities", "visual_theme"],
      "description": "User-facing generator settings (REQUIREMENTS R06 suggested options). Bounded enums so every combination is generatable offline.",
      "properties": {
        "name": { "$ref": "urn:pthd:schema:location-definition:1.0.0#/$defs/latin1_text", "minLength": 1, "maxLength": 24 },
        "region": {
          "anyOf": [
            { "$ref": "urn:pthd:schema:location-definition:1.0.0#/$defs/region_id" },
            { "const": "bonus:north-pole" }
          ]
        },
        "size": { "const": "classic-160x120" },
        "density": { "enum": ["sparse", "normal", "dense"] },
        "road_pattern": { "enum": ["grid", "radial", "coastal", "organic"] },
        "district_count": { "type": "integer", "minimum": 2, "maximum": 12 },
        "economic_difficulty": { "enum": ["easy", "normal", "hard"] },
        "starting_opportunities": { "enum": ["few", "normal", "many"] },
        "visual_theme": { "enum": ["classic", "harbor", "old-town", "suburban", "industrial", "north-pole-village"] },
        "terrain": { "enum": ["inland", "river", "coast", "island"] }
      }
    },
    "change_op": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target", "path"],
      "description": "Constrained JSON-Patch operation on the working definition. old_value is stored so undo never needs to recompute.",
      "properties": {
        "op": { "enum": ["add", "replace", "remove", "move"] },
        "target": { "$ref": "#/$defs/object_ref" },
        "path": { "$ref": "#/$defs/json_pointer" },
        "value": {},
        "old_value": {},
        "from": { "$ref": "#/$defs/object_ref" }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "parent", "branch", "created_utc", "author", "mode", "summary", "transaction_id", "kind", "operations", "document_sha256", "status"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "parent": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "branch": { "$ref": "#/$defs/branch_id" },
        "created_utc": { "$ref": "#/$defs/utc" },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["user", "generator", "importer", "system", "agent"] },
            "id": { "type": "string", "maxLength": 64 }
          }
        },
        "mode": { "enum": ["quick", "guided", "full", "api", "import"] },
        "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
        "transaction_id": { "$ref": "#/$defs/transaction_id" },
        "kind": { "enum": ["create", "edit", "generate", "regenerate", "import", "restore", "checkpoint"] },
        "operations": {
          "type": "array",
          "maxItems": 20000,
          "description": "Empty for kind = checkpoint (the revision then carries a full snapshot in the project store, outside this document).",
          "items": { "$ref": "#/$defs/change_op" }
        },
        "regeneration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stages", "respect_locks", "seed_before", "seed_after", "kept"],
          "properties": {
            "stages": { "type": "array", "minItems": 1, "maxItems": 9, "uniqueItems": true, "items": { "$ref": "#/$defs/stage_id" } },
            "respect_locks": { "const": true },
            "rect": { "$ref": "#/$defs/tile_rect" },
            "seed_before": { "$ref": "#/$defs/u64_decimal" },
            "seed_after": { "$ref": "#/$defs/u64_decimal" },
            "kept": {
              "type": "array",
              "maxItems": 4096,
              "description": "Objects and fields preserved because of locks or manual_fields; shown to the user before the transaction is confirmed.",
              "items": { "$ref": "#/$defs/object_ref" }
            }
          }
        },
        "document_sha256": { "$ref": "#/$defs/sha256" },
        "status": {
          "enum": ["draft", "validated", "integrated-candidate", "gameplay-accepted", "withdrawn"],
          "description": "Admission state of this revision (contract section 8). Derived from receipts whose definition_sha256 matches; stored for display only. Publication is an act on a gameplay-accepted revision, recorded by a publication receipt."
        }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "regenerate" } } }, "then": { "required": ["regeneration"] } }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "severity", "message"],
      "properties": {
        "rule": { "type": "string", "pattern": "^[A-Z]+-[0-9]+$" },
        "severity": { "enum": ["error", "warning"] },
        "message": { "type": "string", "maxLength": 400 },
        "refs": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/object_ref" } },
        "tiles": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": "integer", "minimum": -1, "maximum": 160 },
              "y": { "type": "integer", "minimum": -1, "maximum": 120 }
            }
          }
        },
        "repair": { "type": "string", "maxLength": 200 }
      }
    },
    "receipt_common": {
      "type": "object",
      "required": ["receipt_id", "kind", "revision", "definition_sha256", "created_utc", "result"],
      "properties": {
        "receipt_id": { "$ref": "#/$defs/receipt_id" },
        "revision": { "type": "integer", "minimum": 1 },
        "definition_sha256": { "$ref": "#/$defs/sha256" },
        "created_utc": { "$ref": "#/$defs/utc" },
        "result": { "enum": ["pass", "fail"] }
      }
    },
    "validation_receipt": {
      "allOf": [{ "$ref": "#/$defs/receipt_common" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["validator", "contract_version", "counts", "findings"],
      "properties": {
        "kind": { "const": "validation" },
        "validator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": { "id": { "type": "string", "maxLength": 64 }, "version": { "$ref": "#/$defs/semver" } }
        },
        "contract_version": { "$ref": "#/$defs/semver" },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["errors", "warnings", "rules_run", "rules_skipped"],
          "properties": {
            "errors": { "type": "integer", "minimum": 0 },
            "warnings": { "type": "integer", "minimum": 0 },
            "rules_run": { "type": "integer", "minimum": 0 },
            "rules_skipped": { "type": "integer", "minimum": 0 }
          }
        },
        "findings": { "type": "array", "maxItems": 4096, "items": { "$ref": "#/$defs/finding" } }
      }
    },
    "integration_receipt": {
      "allOf": [{ "$ref": "#/$defs/receipt_common" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["validation_receipt", "content_version", "construct", "save_round_trip"],
      "description": "Promotes validated -> integrated-candidate: the admitted definition is in the content store of a named content version, constructs in an isolated GameState and survives an immediate save/fresh-process load.",
      "properties": {
        "kind": { "const": "integration" },
        "validation_receipt": { "$ref": "#/$defs/receipt_id" },
        "content_version": { "type": "string", "maxLength": 64 },
        "construct": { "enum": ["pass", "fail"] },
        "save_round_trip": { "enum": ["pass", "fail"] },
        "engine_build_id": { "type": "string", "maxLength": 128 }
      }
    },
    "gameplay_receipt": {
      "allOf": [{ "$ref": "#/$defs/receipt_common" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["engine", "probe", "fingerprints", "coverage"],
      "properties": {
        "kind": { "const": "gameplay" },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "build_id", "platform"],
          "properties": {
            "version": { "type": "string", "maxLength": 64 },
            "build_id": { "type": "string", "maxLength": 128 },
            "platform": { "enum": ["windows-x64", "android-arm64", "linux-x64", "macos-arm64"] }
          }
        },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["script_id", "script_sha256", "seed", "steps"],
          "properties": {
            "script_id": { "type": "string", "maxLength": 64 },
            "script_sha256": { "$ref": "#/$defs/sha256" },
            "seed": { "$ref": "#/$defs/u64_decimal" },
            "steps": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["step", "result"],
                "properties": {
                  "step": { "enum": ["construct", "enter", "rent-or-buy", "furnish", "menu", "stock", "staff", "open", "serve", "tick-day", "settle-week", "save", "fresh-process-reload", "compare-fingerprint", "continue-and-compare", "scenario-goal"] },
                  "result": { "enum": ["pass", "fail", "skipped"] },
                  "detail": { "type": "string", "maxLength": 300 }
                }
              }
            }
          }
        },
        "fingerprints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["before_save", "after_reload"],
          "properties": {
            "before_save": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
            "after_reload": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
          }
        },
        "coverage": { "type": "string", "maxLength": 400, "description": "Exactly what the probe exercised and what it did not." },
        "log_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "publication_receipt": {
      "allOf": [{ "$ref": "#/$defs/receipt_common" }],
      "type": "object",
      "unevaluatedProperties": false,
      "required": ["validation_receipt", "integration_receipt", "gameplay_receipt", "published_revision", "supersedes_revision", "store_path"],
      "description": "Makes a gameplay-accepted revision the catalog's current playable revision. Never issued without all three earlier receipts for the same definition_sha256.",
      "properties": {
        "kind": { "const": "publication" },
        "validation_receipt": { "$ref": "#/$defs/receipt_id" },
        "integration_receipt": { "$ref": "#/$defs/receipt_id" },
        "gameplay_receipt": { "$ref": "#/$defs/receipt_id" },
        "published_revision": { "type": "integer", "minimum": 1 },
        "supersedes_revision": { "anyOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }] },
        "store_path": { "type": "string", "pattern": "^locations/[a-z][a-z0-9-]{1,31}/[a-z0-9][a-z0-9-]{1,63}/[0-9]{1,10}/definition\\.json$" }
      }
    }
  }
}
