{
  "format": "pthd.event-resolution-expectations",
  "catalog_id": "pthd-events:core",
  "catalog_revision": 1,
  "rule": "active = events with option enabled, applicable to the location, and whose rule date d (in year-1, year, year+1) satisfies d - before <= date <= d + after; sorted by priority desc then event_id. Off -> []. No clock read in in-game mode; no RNG in any mode.",
  "cases": [
    {
      "case_id": "off-mode",
      "mode": "off",
      "date": "1995-12-24",
      "location_key": "classic:paris",
      "disabled": [],
      "expected_active": [],
      "expected_preview": []
    },
    {
      "case_id": "in-game-advent",
      "mode": "in-game-calendar",
      "date": "1995-12-20",
      "location_key": "classic:paris",
      "disabled": [],
      "expected_active": [
        "pthd-events:christmas-decor"
      ],
      "expected_preview": []
    },
    {
      "case_id": "year-boundary",
      "mode": "in-game-calendar",
      "date": "1996-01-01",
      "location_key": "classic:paris",
      "disabled": [],
      "expected_active": [
        "pthd-events:new-year-fireworks",
        "pthd-events:christmas-decor"
      ],
      "expected_preview": [],
      "note": "Dec 25 of the previous year + 7 days reaches Jan 1"
    },
    {
