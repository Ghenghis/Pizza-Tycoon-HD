{
  "format": "pthd.page-math-expectations",
  "ui_only": true,
  "formula": "pages(N, size) = ceil(N / size) = (N + size - 1) div size; 0 when N = 0",
  "page_sizes": {
    "desktop": 12,
    "tablet": 12,
    "phone": 6
  },
  "clamp": "page_after = 0 if pages_after = 0 else min(max(page_before, 1), pages_after); when a selection exists, the page follows the selected item: index div size + 1",
  "selection": "kept by location_key; if the selected entry is gone, select index min(old_index, N_after - 1)",
  "wrap": false,
  "cases": [
    {
      "case_id": "exact-fit-desktop",
      "page_size": 12,
      "n_before": 12,
      "pages_before": 1,
      "page_before": 1,
      "change": "none",
      "n_after": 12,
      "pages_after": 1,
      "page_after": 1,
      "empty_state": false,
      "paging_enabled": false,
      "note": "12 items fill one desktop page"
    },
    {
      "case_id": "one-over-desktop",
      "page_size": 12,
      "n_before": 13,
      "pages_before": 2,
      "page_before": 2,
      "change": "none",
      "n_after": 13,
      "pages_after": 2,
      "page_after": 2,
      "empty_state": false,
      "paging_enabled": true,
      "note": "partial last page holds 1 item"
    },
    {
      "case_id": "one-over-phone",
      "page_size": 6,
      "n_before": 7,
      "pages_before": 2,
      "page_before": 2,
      "change": "none",
      "n_after": 7,
      "pages_after": 2,
      "page_after": 2,
      "empty_state": false,
      "paging_enabled": true,
      "note": "partial last page holds 1 item"
    },
    {
      "case_id": "delete-last-item-on-last-page",
      "page_size": 12,
      "n_before": 13,
      "pages_before": 2,
      "page_before": 2,
      "change": "delete",
      "n_after": 12,
      "pages_after": 1,
      "page_after": 1,
      "empty_state": false,
      "paging_enabled": false,
      "note": "page 2 disappears; clamp to page 1 and select the new last item",
      "selected_index_before": 12,
      "selected_removed": true,
      "selected_index_after": 11
    },
    {
      "case_id": "delete-before-selection",
      "page_size": 12,
      "n_before": 25,
      "pages_before": 3,
      "page_before": 3,
      "change": "delete-before-selection",
      "n_after": 24,
      "pages_after": 2,
      "page_after": 2,
      "empty_state": false,
      "paging_enabled": true,
      "note": "selected item keeps its key; its index drops to 23, now on page 2",
      "selected_index_before": 24,
      "selected_removed": false,
      "selected_index_after": 23
    },
    {
      "case_id": "filter-to-zero",
      "page_size": 6,
      "n_before": 40,
      "pages_before": 7,
      "page_before": 5,
      "change": "filter",
      "n_after": 0,
      "pages_after": 0,
      "page_after": 0,
      "empty_state": true,
      "paging_enabled": false,
      "note": "no results: empty state, page 0, paging disabled, no selection",
      "selected_index_before": 27,
      "selected_removed": true,
      "selected_index_after": null
    },
    {
      "case_id": "filter-shrinks",
      "page_size": 6,
      "n_before": 40,
      "pages_before": 7,
      "page_before": 7,
      "change": "filter",
      "n_after": 9,
      "pages_after": 2,
      "page_after": 2,
      "empty_state": false,
      "paging_enabled": true,
      "note": "pages 7 -> 2; clamp current page to 2"
    },
    {
      "case_id": "import-grows",
      "page_size": 12,
      "n_before": 12,
      "pages_before": 1,
      "page_before": 1,
      "change": "import",
      "n_after": 30,
      "pages_after": 3,
      "page_after": 1,
      "empty_state": false,
      "paging_enabled": true,
      "note": "pages 1 -> 3; current page unchanged"
    },
    {
      "case_id": "phone-1000-region",
      "page_size": 6,
      "n_before": 125,
      "pages_before": 21,
      "page_before": 21,
      "change": "none",
      "n_after": 125,
      "pages_after": 21,
      "page_after": 21,
      "empty_state": false,
      "paging_enabled": true,
      "note": "125 per region -> 21 phone pages, last holds 5"
    },
    {
      "case_id": "desktop-1000-region",
      "page_size": 12,
      "n_before": 125,
      "pages_before": 11,
      "page_before": 11,
      "change": "none",
      "n_after": 125,
      "pages_after": 11,
      "page_after": 11,
      "empty_state": false,
      "paging_enabled": true,
      "note": "125 per region -> 11 desktop pages, last holds 5"
    },
    {
      "case_id": "all-1000-phone",
      "page_size": 6,
      "n_before": 1000,
      "pages_before": 167,
      "page_before": 167,
      "change": "none",
      "n_after": 1000,
      "pages_after": 167,
      "page_after": 167,
      "empty_state": false,
      "paging_enabled": true,
      "note": "all locations, phone: 167 pages"
    },
    {
      "case_id": "all-1000-desktop",
      "page_size": 12,
      "n_before": 1000,
      "pages_before": 84,
      "page_before": 84,
      "change": "none",
      "n_after": 1000,
      "pages_after": 84,
      "page_after": 84,
      "empty_state": false,
      "paging_enabled": true,
      "note": "all locations, desktop: 84 pages"
    },
    {
      "case_id": "empty-region",
      "page_size": 12,
      "n_before": 0,
      "pages_before": 0,
      "page_before": 0,
      "change": "none",
      "n_after": 0,
      "pages_after": 0,
      "page_after": 0,
      "empty_state": true,
      "paging_enabled": false,
      "note": "zero results never show page 1 of 0"
    }
  ]
}
